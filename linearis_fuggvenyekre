vector<line> combine(vector<line> a, vector<line> b) {
    double buffer=0;
    vector<line> res;

    int sa=a.size(), sb=b.size();
    a.push_back(close_line), b.push_back(close_line);
    int i=0, j=0;

    while (i<sa || j<sb) {
        double la=a[i].l, ra=a[i].r, xa=a[i].x, ya=a[i].y;
        double lb=b[j].l, rb=b[j].r, xb=b[j].x, yb=b[j].y;
        //cout << "alap " << la << " " << ra << " " << lb << " " << rb << "\n";
        if (abs(la-lb)<eps) {
            if (abs(lb-rb)<eps) {
                i++, j++;
            }
            else if (ra+eps<rb) {
                double midval=eval(b[j], ra);
                //cout << "fontos " << ra << " " << rb << " " << midval << " " << yb << "\n";
                b[j]={ra, rb, midval, yb};
                yb=midval;
                i++;
            }
            else {
                double midval=eval(a[i], rb);
                a[i]={rb, ra, midval, ya};
                ya=midval;
                j++;
            }
            ra=min(ra, rb), rb=min(ra, rb);
            bool p=(xa>=xb), q=(ya>=yb);
            //cout << "allas " << p << " " << q << "\n";
            if (p==q) {
                special_case(la, ra, xa, ya, xb, yb, buffer, res);
            } else {
                double midpoint=la+(xa-xb)/((xa-xb)+(yb-ya))*(ra-la);
                double midval=xa+(ya-xa)*(midpoint-la)/(ra-la);
                special_case(la, midpoint, xa, midval, xb, midval, buffer, res);
                special_case(midpoint, ra, midval, ya, midval, yb, buffer, res);
            }
            //cout << "vege " << buffer << "\n";
        }
        else if (la<lb) {
            // integralhoz hozza kell adni a maradekot
            if (ra<=lb) {
                buffer+=(xa+ya)*(ra-la)/2;
                i++;
            } else {
                double midval=eval(a[i], lb);
                buffer+=(xa+midval)*(lb-la)/2;
                a[i]={lb, ra, midval, ya};
            }
        }
        else {
            //cout << "fontos " << la << " " << ra << " " << lb << " " << rb << " " << buffer << "\n";
            // addig kell kivalasztani, amig belefer a limitbe
            double m=(yb-xb)/(rb-lb);
            double lo=lb, hi=min(rb, la)+eps, mid;
            while (hi-lo>eps) {
                mid=(hi+lo)/2;
                double area=(xb+xb+m*(mid-lb))*(mid-lb)/2;
                if (area<=buffer) {
                    lo=mid;
                } else {
                    hi=mid;
                }
            }
            if (lo-lb>eps) {
                double area=(xb+xb+m*(lo-lb))*(lo-lb)/2;
                buffer-=area;
                res.push_back({lb, lo, xb, xb+m*(lo-lb)});
            }
            if (la<rb) {
                double midval=eval(b[j], la);
                b[j]={la, rb, midval, yb};
            } else {
                j++;
            }
        }
    }
    return res;
}
vector<line> find_next(vector<line> a, vector<line> b) {
    //cout << "find_next:\n";
    //print(a);
    //print(b);
    return combine(a, b);
}
void mirror(vector<line> &a) {
    int si=a.size();
    for (int i=0; i<si; i++) {
        double ll=a[i].l, rr=a[i].r;
        a[i].l=-rr, a[i].r=-ll;
        double xx=a[i].x, yy=a[i].y;
        a[i].x=yy, a[i].y=xx;
    }
    reverse(a.begin(), a.end());
}
