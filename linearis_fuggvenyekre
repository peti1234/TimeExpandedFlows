void modify(vector<line> &a, vector<line> b, int val) {
    vector<line> res;
    int sa=a.size(), sb=b.size();
    a.push_back(close_line), b.push_back(close_line);
    if (val==-1) {
        for (int i=0; i<sb; i++) {
            b[i].x*=-1;
            b[i].y*=-1;
        }
    }
    int i=0, j=0;
    while (i<sa || j<sb) {
        double la=a[i].l, ra=a[i].r, xa=a[i].x, ya=a[i].y;
        double lb=b[j].l, rb=b[j].r, xb=b[j].x, yb=b[j].y;

        if (abs(la-lb)<eps) {
            if (abs(ra-rb)<eps) {
                res.push_back({la, ra, xa+xb, ya+yb});
                i++;
                j++;
            }
            else if (ra>rb) {
                double midval=eval(a[i], rb);
                res.push_back({lb, rb, xa+xb, midval+yb});
                a[i]={rb, ra, midval, ya};
                j++;
            }
            else {
                double midval=eval(b[j], ra);
                res.push_back({la, ra, xa+xb, midval+ya});
                b[j]={ra, rb, midval, yb};
                i++;
            }
        }
        else if (la<lb) {
            if (ra<=lb) {
                res.push_back(a[i]);
                i++;
            } else {
                double midval=eval(a[i], lb);
                res.push_back({la, lb, xa, midval});
                a[i]={lb, ra, midval, ya};
            }
        }
        else {
            assert(la>lb);
            assert(val==1);
            if (rb<=la) {
                res.push_back(b[j]);
                j++;
            } else {
                double midval=eval(b[j], la);
                res.push_back({lb, la, xb, midval});
                b[j]={la, rb, midval, yb};
            }
        }
    }
    a=res;
    /*cout << "valasz\n";
    print(res);*/
    compress(a);
    return;
}

