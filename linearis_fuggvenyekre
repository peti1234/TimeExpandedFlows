#include <bits/stdc++.h>

using namespace std;
const int maxn=1005;
const double eps=1e-6, inf=1e9;
struct line {
    double l, r, x, y;
    bool operator<(const line& other) const {
        return l<other.l;
    }
};
line close_line={inf+1, inf+1, 0, 0};

int n;
vector<int> adj[maxn];
vector<line> graph[maxn][maxn];

double ans;

void compress(vector<line> &v) {
    // az egy vonalon levoket is ossze lehetne vonni
    vector<line> v2;
    for (auto p:v) {
        if (p.x+eps>p.y || (p.l<eps && p.r<eps)) {
            continue;
        }
        v2.push_back(p);
    }
    v=v2;
}

double get_integral(vector<line> &v) {
    double ans=0;
    for (auto p:v) {
        ans+=(p.x+p.y)*(p.r-p.l)/2;
    }
    return ans;
}
double get_priority(vector<line> v) {
    return get_integral(v); // valami bonyolultabb is lehetne
}
double eval(line a, double pos) {
    double la=a.l, ra=a.r, xa=a.x, ya=a.y;
    if (abs(la-ra)<eps) {
        return 0;
    }
    double res=((ra-pos)*xa+(pos-la)*ya)/(ra-la);
    return res;
}
void special_case(double l, double r, double xa, double ya, double xb, double yb, double &buffer, vector<line> &res) {
    if (abs(r-l)<eps) return;
    if (xa>=xb) {
        res.push_back({l, r, xb, yb});
        buffer+=(r-l)*(xa+ya-xb-yb)/2;
    } else {
        double lo=l, hi=r+eps, mid;
        while (hi-lo>eps) {
            mid=(hi+lo)/2;
            double val1=(xa*(r-mid)+ya*(mid-l))/(r-l), val2=(xb*(r-mid)+yb*(mid-l))/(r-l);
            double area=(xb-xa+val2-val1)*(mid-lo)/2;
            if (area<=buffer) {
                lo=mid;
            } else {
                hi=mid;
            }
        }
        double val1=(xa*(r-lo)+ya*(lo-l))/(r-l), val2=(xb*(r-lo)+yb*(lo-l))/(r-l);
            double area=(xb-xa+val2-val1)*(lo-lo)/2;
        if (l+eps<lo) {
            buffer-=area;
            res.push_back({l, lo, xb, val2});
        }
        if (lo+eps<r) {
            res.push_back({lo, r, val1, ya});
        }

    }
}
